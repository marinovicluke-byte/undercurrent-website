# N8N webhook — handles both PDF send and benchmark data storage
VITE_N8N_AUDIT_WEBHOOK_URL=https://your-n8n-instance.com/webhook/audit
NEXT_PUBLIC_AHREFS_KEY=your-ahrefs-web-analytics-key

# Google reviews lead funnel (POST /api/leads/google-reviews). Server only, set in Vercel.
LEADS_SUPABASE_URL=https://your-project.supabase.co
LEADS_SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Cal.com slot source. Username and slugs default to Luke's public booking page.
CAL_USERNAME=luke-marinovic-aqeosc
CAL_EVENT_SLUG_15=15min
CAL_EVENT_SLUG_30=30min
CAL_API_KEY=
# Meta Conversions API (Lead, deduped with the Pixel by event_id)
META_PIXEL_ID=1567729764986823
META_CAPI_TOKEN=your-capi-token
META_CAPI_TEST_EVENT_CODE=
# PostHog server event gr_lead_created (same key the site already loads)
NEXT_PUBLIC_POSTHOG_KEY=phc_your_key
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
